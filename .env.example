# Environment Variables for FoundryAI
# Copy this file, rename to .env.local, and fill in your values

# ==========================================
# SUPABASE
# ==========================================
# Found at: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (server-side only, never expose to browser)
# Found at: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# OPENAI
# ==========================================
# Found at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ==========================================
# APP
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
